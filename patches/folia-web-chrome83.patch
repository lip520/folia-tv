+// Folia TV：把 dist 里的 CSS 降到坚果投影 Chrome 83 WebView 可解析的水平
+// 1) 解包 @layer 块（Chrome 99-，整块会被丢弃）
+// 2) :where(SEL) → SEL、:is(SEL) → :-webkit-any(SEL)（Chrome 88- 不认识这两个伪类）
+// 3) LightningCSS 处理 color-mix / inset 简写等（目标 Chrome 83）
+import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { transform } from 'lightningcss';
+
+// 提取从 openIdx（'(' 的位置）开始的平衡括号内容，返回 [inner, endIdx)
+const extractParens = (css, openIdx) => {
+    let depth = 0;
+    for (let j = openIdx; j < css.length; j++) {
+        const c = css[j];
+        if (c === '(') depth++;
+        else if (c === ')') {
+            depth--;
+            if (depth === 0) return [css.slice(openIdx + 1, j), j + 1];
+        }
+    }
+    return [css.slice(openIdx + 1), css.length];
+};
+
+const replacePseudoFns = (input, name, replacement) => {
+    let res = '', i = 0;
+    const needle = name + '(';
+    while (i < input.length) {
+        const idx = input.indexOf(needle, i);
+        if (idx === -1) { res += input.slice(i); break; }
+        const [inner, end] = extractParens(input, idx + name.length);
+        res += input.slice(i, idx) + replacement(inner);
+        i = end;
+    }
+    return res;
+};
+
+const unwrapPseudoFns = (css) => {
+    let out = css, prev;
+    do {
+        prev = out;
+        out = replacePseudoFns(out, ':where', (inner) => inner);
+        out = replacePseudoFns(out, ':is', (inner) => `:-webkit-any(${inner})`);
+    } while (out !== prev);
+    return out;
+};
+
+const unwrapLayers = (css) => {
+    let out = '', i = 0;
+    while (i < css.length) {
+        const rest = css.slice(i);
+        const m = /@layer\b/.exec(rest);
+        if (!m) { out += rest; break; }
+        const start = i + m.index;
+        const brace = css.indexOf('{', start);
+        const semi = css.indexOf(';', start);
+        out += css.slice(i, start);
+        if (semi !== -1 && (brace === -1 || semi < brace)) {
+            // 语句形式 @layer a, b; —— 层级声明，删除即可（块都按源码顺序展开）
+            i = semi + 1;
+            continue;
+        }
+        let depth = 0, j = brace;
+        for (; j < css.length; j++) {
+            if (css[j] === '{') depth++;
+            else if (css[j] === '}') { depth--; if (depth === 0) break; }
+        }
+        out += css.slice(brace + 1, j);
+        i = j + 1;
+    }
+    return out;
+};
+
+const dir = new URL('../dist/assets/', import.meta.url).pathname;
+let total = 0;
+for (const name of readdirSync(dir)) {
+    if (!name.endsWith('.css')) continue;
+    const p = join(dir, name);
+    const raw = readFileSync(p, 'utf8');
+    total++;
+    try {
+        const manual = unwrapPseudoFns(unwrapLayers(raw));
+        const res = transform({
+            filename: name,
+            code: Buffer.from(manual),
+            minify: true,
+            errorRecovery: true,
+            targets: { chrome: 83 << 16 },
+        });
+        // inset 简写是 Chrome 87+；LC 不展开带 var()/calc 的值，手动展开为四向写法
+        const css = res.code.toString().replace(
+            /(^|[;{])inset:([^;}]+)/g,
+            (_, pre, v) => `${pre}top:${v};right:${v};bottom:${v};left:${v}`
+        );
+        writeFileSync(p, css);
+    } catch (e) {
+        console.error(`[fix-css-tv] ${name} failed: ${e.message}`);
+        process.exitCode = 1;
+    }
+}
+console.log(`[fix-css-tv] processed ${total} css files`);
